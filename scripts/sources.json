{
  "$schema": "./sources.schema.json",
  "description": "Seed repositories for Keybox Hub. Merged with GitHub Search API results.",
  "seeds": [
    "beakthoven/TrickyStoreOSS",
    "5ec1cff/TrickyStore",
    "Yurii0307/yurikey",
    "MeowDump/Integrity-Box",
    "purainity/keybox-tools",
    "chiteroman/PlayIntegrityFix",
    "HuskyDG/magisk-files",
    "Magisk-Modules-Repo/playintegrityfix",
    "soralis0912/keybox",
    "hongshui3000/keybox",
    "WongKit/keybox",
    "TheGenesisOfAngel/keybox",
    "codehz/keybox",
    "vvb2060/KeyAttestation",
    "kdrag0n/safetynet-fix",
    "Displax/safetynet-fix",
    "topjohnwu/Magisk"
  ],
  "search": {
    "repositories": [
      "keybox in:name,description,readme",
      "keybox.xml in:readme",
      "attestation keybox in:name,description"
    ],
    "code": [
      "filename:keybox.xml",
      "filename:Keybox.xml"
    ],
    "maxSources": 30,
    "sortBy": "stars",
    "order": "desc"
  },
  "filePatterns": [
    "keybox.xml",
    "*keybox*.xml",
    "Keybox*.xml",
    "KEYBOX*.XML"
  ],
  "limits": {
    "maxFilesPerRepo": 40,
    "maxTotalFiles": 600,
    "maxCommitLookups": 400
  }
}
